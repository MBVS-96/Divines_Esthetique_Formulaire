# Copy to .env.local and fill in.
# With none of these set, the app runs in demo mode: everything is stored in
# the browser and no email leaves the machine.

# --- Supabase (production backend) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email used to sign in at /admin (created in Supabase Auth > Users).
VITE_ADMIN_EMAIL=

# --- Public contact details ---
VITE_CONTACT_EMAIL=contact@pachobarberstyle.ch
VITE_INSTAGRAM_URL=https://instagram.com/

# --- Demo only ---
# Admin password while running without Supabase. Defaults to "pacho".
VITE_DEMO_ADMIN_PASSWORD=pacho
